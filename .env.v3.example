# V3 araç yolları — .env.v3.local olarak kopyalayıp doldurun. Boş bırakılan değerler repo içi varsayılanları kullanır (bin/, output/).
ATOLYE_V3_TOOLS_ROOT=
ATOLYE_V3_BACKDROP_LIBRARY=
ATOLYE_V3_PIPER_EXE=
ATOLYE_V3_PIPER_VOICE=
ATOLYE_V3_WHISPER_EXE=
ATOLYE_V3_WHISPER_MODEL=
ATOLYE_V3_VOICE_REFS=
ATOLYE_V3_ASCII_TEMP=
# Senaryo motoru. Sağlayıcı: ollama (yerel, ücretsiz; varsayılan) | openai (ücretli, video başına tavan 1 $).
ATOLYE_V3_SCRIPT_PROVIDER=
ATOLYE_V3_WRITER_MODEL=
ATOLYE_V3_CHECKER_MODEL=
# OPENAI_API_KEY'in okunacağı env dosyasının YOLU (ör. ana uygulamanın .env.local'ı). Anahtarın kendisini buraya yazmayın.
ATOLYE_V3_SECRETS_ENV=
