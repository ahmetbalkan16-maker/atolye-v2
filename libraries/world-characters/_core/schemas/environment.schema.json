{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "World environment metadata V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "civilization",
    "period",
    "role",
    "variant",
    "version",
    "status",
    "review",
    "provenance",
    "files",
    "characterId",
    "availability",
    "setting"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "environment"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "civilization": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "period": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "role": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "variant": {
      "$ref": "common.schema.json#/$defs/slug"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "status": {
      "enum": [
        "placeholder",
        "draft",
        "ready"
      ]
    },
    "review": {
      "enum": [
        "pending",
        "owner-approved"
      ]
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/file"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "characterId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "availability": {
      "enum": [
        "none",
        "planned",
        "present"
      ]
    },
    "setting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
