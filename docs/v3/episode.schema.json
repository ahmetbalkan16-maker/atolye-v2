{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atolye.local/v3/episode.schema.json",
  "title": "Atölye V3 bölüm dosyası (episode.json)",
  "description": "Senaryo motorunun yazdığı, bütün V3 modüllerinin okuduğu bölüm sözleşmesi. Anlamsal kurallar (kadro/kaynak referansları, argo yasağı, diyalog oranı) src/lib/v3/episode/EpisodeValidator.ts içindedir.",
  "type": "object",
  "required": ["id", "baslik", "konu", "donem", "hedef_sure_sn", "ton", "kaynaklar", "oyuncu_kadrosu", "sahneler"],
  "additionalProperties": false,
  "$defs": {
    "lonlat": { "type": "array", "prefixItems": [{ "type": "number", "minimum": -180, "maximum": 180 }, { "type": "number", "minimum": -85, "maximum": 85 }], "minItems": 2, "maxItems": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "aksesuar": { "type": "string", "pattern": "^([a-z0-9-]+/)?[a-z0-9-]+$" },
    "duygu": { "enum": ["notr", "mutlu", "kizgin", "saskin", "korkmus", "uzgun", "kararli", "sinsi"] },
    "jest": { "enum": ["konus", "isaret_et", "el_salla", "sasir", "egil", "kollari_kavustur", "dusun", "omuz_silk", "yumruk_kaldir", "elleri_belde", "yuz_avucla", "kutla"] },
    "kostum": {
      "type": "object",
      "required": ["giysi", "renkler", "ayakkabi"],
      "additionalProperties": false,
      "properties": {
        "sac": { "type": "object", "required": ["stil", "renk"], "additionalProperties": false, "properties": { "stil": { "enum": ["kisa", "dalgali", "yan_ayrik", "uzun", "topuz", "orgu", "kel", "kivircik", "kakul", "geriye", "seyrek"] }, "renk": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } },
        "sac_parca": { "$ref": "#/$defs/aksesuar" },
        "gogus": { "$ref": "#/$defs/aksesuar" },
        "yuz": {
          "type": "object",
          "additionalProperties": false,
          "description": "Gerçek kişinin portresinden okunan çizili benzerlik (LikenessDesigner).",
          "properties": {
            "sekil": { "enum": ["yuvarlak", "oval", "uzun", "genis", "kare"] },
            "ten": { "$ref": "#/$defs/hex" },
            "burun": { "enum": ["yok", "kucuk", "duz", "iri", "kemerli", "kalkik"] },
            "goz": { "enum": ["nokta", "detayli"] },
            "kas_renk": { "$ref": "#/$defs/hex" },
            "yas": { "enum": ["genc", "orta", "yasli"] }
          }
        },
        "giysi": { "enum": ["kaftan", "cubbe", "zirh", "onluk", "bizans", "yeniceri", "sade", "tunik", "toga", "ceket", "uniforma", "takim", "elbise"] },
        "renkler": {
          "type": "object",
          "required": ["ana", "ikincil", "ic", "sus"],
          "additionalProperties": false,
          "properties": { "ana": { "$ref": "#/$defs/hex" }, "ikincil": { "$ref": "#/$defs/hex" }, "ic": { "$ref": "#/$defs/hex" }, "sus": { "$ref": "#/$defs/hex" } }
        },
        "bas": { "$ref": "#/$defs/aksesuar" },
        "sakal": { "$ref": "#/$defs/aksesuar" },
        "biyik": { "$ref": "#/$defs/aksesuar" },
        "el_on": { "$ref": "#/$defs/aksesuar" },
        "el_arka": { "$ref": "#/$defs/aksesuar" },
        "sirt": { "$ref": "#/$defs/aksesuar" },
        "yaka": { "enum": ["kurk", "yok"] },
        "pelerin": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "ayakkabi": { "type": "string" }
      }
    },
    "oyuncu": {
      "type": "object",
      "required": ["id", "ad", "rol", "kostum_paketi", "renk", "ses_id", "konusma_tarzi", "gorunur"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "ad": { "type": "string", "maxLength": 80 },
        "rol": { "type": "string", "maxLength": 120 },
        "kostum_paketi": { "type": "string" },
        "renk": { "$ref": "#/$defs/hex" },
        "ses_id": { "$ref": "#/$defs/slug" },
        "konusma_tarzi": { "type": "string", "maxLength": 300 },
        "gorunur": { "type": "boolean" },
        "kostum": { "$ref": "#/$defs/kostum" },
        "olcek": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "portre": { "type": "object", "required": ["wiki"], "additionalProperties": false, "properties": { "wiki": { "type": "string", "maxLength": 120 } } }
      }
    },
    "satir": {
      "type": "object",
      "required": ["karakter", "metin", "duygu"],
      "additionalProperties": false,
      "properties": {
        "karakter": { "$ref": "#/$defs/slug" },
        "metin": { "type": "string", "minLength": 1, "maxLength": 240 },
        "duygu": { "$ref": "#/$defs/duygu" },
        "jest": { "$ref": "#/$defs/jest" },
        "hareket": { "enum": ["yuru", "kos", "dur", "gir", "cik"] },
        "hedef": { "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "number", "minimum": 0, "maximum": 1 }] },
        "sfx": { "enum": ["whoosh", "pop", "boing", "kilic", "top_atisi", "davul", "kalabalik", "cekic", "dalga", "zil", "yumruk", "dusus", "adim", "kapi", "para", "kagit", "basari", "hata"] },
        "efekt": { "enum": ["ter", "unlem", "soru", "ofke", "parilti", "kalp"] },
        "kaynak": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "kurgu": { "type": "boolean" },
        "rivayet": { "type": "boolean" },
        "vurgu": { "type": "array", "items": { "type": "string" } },
        "balon": { "type": "string", "minLength": 1, "maxLength": 70, "description": "Words floating over a visible speaker: punchline or key phrase, at most 8 words" }
      }
    },
    "sahne": {
      "type": "object",
      "required": ["id", "sure_hedef", "mekan", "arka_plan_sorgusu", "duygu", "muzik_ruh_hali", "satirlar"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "sure_hedef": { "type": "number", "minimum": 2, "maximum": 600 },
        "mekan": { "type": "string", "maxLength": 160 },
        "arka_plan_sorgusu": {
          "type": "object",
          "required": ["tr", "en"],
          "additionalProperties": false,
          "properties": {
            "tr": { "type": "string" },
            "en": { "type": "string" },
            "wiki": { "type": "string", "maxLength": 120 },
            "ara": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
            "tasarim": { "type": "string", "maxLength": 700 },
            "commons_kategori": { "type": "string" },
            "yerel_tema": { "type": "string" },
            "dosya": { "type": "string" },
            "tur": { "enum": ["set", "archival"] }
          }
        },
        "duygu": { "enum": ["gerilim", "komik", "huzun", "zafer", "gizem", "merak"] },
        "muzik_ruh_hali": { "type": "string" },
        "kamera": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tip", "t"],
            "additionalProperties": false,
            "properties": { "tip": { "enum": ["zoom", "pan", "shake", "cut"] }, "t": { "type": "number", "minimum": 0 }, "hedef": { "type": "string" } }
          }
        },
        "harita": {
          "type": "object",
          "description": "Arrows over an archival map image (points 0..1), or with merkez + genislik_km a drawn Natural Earth map (points [lon, lat])",
          "properties": {
            "merkez": { "$ref": "#/$defs/lonlat" },
            "genislik_km": { "type": "number", "minimum": 20, "maximum": 40000 },
            "bolgeler": { "type": "array", "items": { "type": "object", "required": ["ad", "renk"], "properties": { "ad": { "type": "string" }, "renk": { "$ref": "#/$defs/hex" }, "ulkeler": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z]{3}$" } }, "noktalar": { "type": "array", "items": { "$ref": "#/$defs/lonlat" } }, "etiket_konum": { "$ref": "#/$defs/lonlat" }, "satir": { "type": "integer", "minimum": 0 }, "bitis_satir": { "type": "integer", "minimum": 0, "description": "Bölgenin kaybolduğu satır (sınır değişimi)." }, "tarihi": { "type": "object", "required": ["ad", "yil"], "additionalProperties": false, "description": "Tarihî atlas sınırı (aourednik/historical-basemaps): kutup adı ve anlık görüntü yılı (MÖ negatif).", "properties": { "ad": { "type": "string", "maxLength": 80 }, "yil": { "type": "integer", "minimum": -123000, "maximum": 2100 } } } } } },
            "sehirler": { "type": "array", "items": { "type": "object", "required": ["ad", "konum"], "properties": { "ad": { "type": "string" }, "konum": { "$ref": "#/$defs/lonlat" } } } },
            "ordular": { "type": "array", "items": { "type": "object", "required": ["ad", "konum", "renk"], "properties": { "ad": { "type": "string" }, "konum": { "$ref": "#/$defs/lonlat" }, "renk": { "$ref": "#/$defs/hex" }, "satir": { "type": "integer", "minimum": 0 } } } },
            "oklar": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["noktalar"],
                "properties": {
                  "noktalar": { "type": "array", "minItems": 2, "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 } },
                  "renk": { "$ref": "#/$defs/hex" },
                  "etiket": { "type": "string" },
                  "satir": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "kamera": {
              "type": "array",
              "description": "Harita anlatımı: satırla birlikte kamera yeni merkeze ve genişliğe kayar.",
              "items": { "type": "object", "required": ["satir", "merkez", "genislik_km"], "properties": { "satir": { "type": "integer", "minimum": 0 }, "merkez": { "$ref": "#/$defs/lonlat" }, "genislik_km": { "type": "number", "minimum": 20, "maximum": 40000 } } }
            },
            "rozetler": {
              "type": "array",
              "description": "Hükümdar rozeti: kadrodaki karakterin başı, bir yerde; yol verilirse o rota boyunca noktalı iz bırakarak ilerler, yol_satir satırında yola çıkar (yoksa hemen).",
              "items": { "type": "object", "required": ["karakter", "konum"], "properties": { "karakter": { "type": "string" }, "konum": { "$ref": "#/$defs/lonlat" }, "satir": { "type": "integer", "minimum": 0 }, "bitis_satir": { "type": "integer", "minimum": 0 }, "yol": { "type": "array", "items": { "$ref": "#/$defs/lonlat" } }, "yol_satir": { "type": "integer", "minimum": 0 } } }
            },
            "savaslar": {
              "type": "array",
              "items": { "type": "object", "required": ["ad", "konum"], "properties": { "ad": { "type": "string", "maxLength": 50 }, "konum": { "$ref": "#/$defs/lonlat" }, "satir": { "type": "integer", "minimum": 0 } } }
            }
          }
        },
        "yazi_karti": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metin", "stil"],
            "additionalProperties": false,
            "properties": { "metin": { "type": "string" }, "alt_metin": { "type": "string" }, "stil": { "enum": ["yer_tarih", "bolum", "bilgi", "kelime"] }, "satir": { "type": "integer", "minimum": 0 } }
          }
        },
        "sahne_duzeni": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["karakter", "x"],
            "additionalProperties": false,
            "properties": {
              "karakter": { "$ref": "#/$defs/slug" },
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "derinlik": { "type": "number", "minimum": 0, "maximum": 1 },
              "yon": { "enum": ["sol", "sag"] },
              "oturuyor": { "type": "boolean" }
            }
          }
        },
        "dekor": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tur", "x"],
            "additionalProperties": false,
            "properties": {
              "tur": { "enum": ["taht", "top", "kule_iskelesi", "gemi", "masa", "sancak"] },
              "x": { "type": "number", "minimum": -0.2, "maximum": 1.2 },
              "derinlik": { "type": "number", "minimum": 0, "maximum": 1 },
              "olcek": { "type": "number" },
              "ters": { "type": "boolean" }
            }
          }
        },
        "kalabalik": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ad", "kostum_paketi", "kostum", "sayi", "duzen"],
            "additionalProperties": false,
            "properties": {
              "ad": { "type": "string", "maxLength": 80 },
              "kostum_paketi": { "$ref": "#/$defs/slug" },
              "kostum": { "$ref": "#/$defs/kostum" },
              "sayi": { "type": "integer", "minimum": 2, "maximum": 40 },
              "duzen": { "enum": ["sira", "meclis", "ordu"] },
              "taraf": { "enum": ["sol", "sag", "tum"] },
              "ruh_hali": { "enum": ["notr", "coskulu", "korkmus"] }
            }
          }
        },
        "gecis": { "enum": ["kes", "kaydir", "murekkep", "beyaz"] },
        "satirlar": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/satir" } }
      }
    }
  },
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "baslik": { "type": "string", "maxLength": 120 },
    "konu": { "type": "string", "maxLength": 300 },
    "donem": { "type": "string", "maxLength": 120 },
    "hedef_sure_sn": { "type": "number", "minimum": 20, "maximum": 1800 },
    "ton": { "enum": ["mizahi", "ciddi", "epik"] },
    "kaynaklar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kunye"],
        "additionalProperties": false,
        "properties": { "id": { "$ref": "#/$defs/slug" }, "kunye": { "type": "string", "maxLength": 400 }, "url": { "type": "string", "pattern": "^https://" } }
      }
    },
    "oyuncu_kadrosu": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/oyuncu" } },
    "sahneler": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sahne" } }
  }
}
