+export async function admitAyasOwnerApproval(input: {
+  readonly gate: AccessGateConfig;
+  readonly token: string | undefined;
+  readonly action: AyasOwnerAdmissionAction;
+  readonly subject: AyasOwnerAdmissionSubject;
+  readonly now?: number;
