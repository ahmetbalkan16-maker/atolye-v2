+export type AyasOwnerAdmissionBindingResult = { readonly ok: true } | { readonly ok: false; readonly reason: "INVALID_SEAL" | "INVALID_ACTION" | "MALFORMED" | "SUBJECT_MISMATCH" | "ACTION_REF_REUSED" | "STALE" | "FUTURE" };
