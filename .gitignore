# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-devserver.*.log

# one-off generated reports / dumps (regenerate on demand, do not commit)
/OPENAI-LOCAL-MIGRATION-PLAN.md

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

graphify-out/
.graphify/

.claude/

.agents/

# Local AI runtime binaries + models (installed per-machine, not committed)
/bin/piper/
/data/e2e-output/

# Runtime-only project artifacts (regenerated by the app, never hand-authored)
#  - "unknown" is AIUsageManager's orphan bucket for context-less AI calls
#    (telemetry: token counts / cost estimates). It was committed once by
#    accident in Sprint 81; the real projects keep their own ai-usage.json.
#  - .pipeline-jobs.lock/ is PipelineJobMutationLock's process-local mutex dir.
/data/projects/unknown/
**/.pipeline-jobs.lock/

# ---------------------------------------------------------------------------
# Local project working data — NOT a blanket /data/projects/*/ ignore.
#
# The repo tracks completed / milestone project snapshots that were added
# deliberately (e.g. commit "Complete Fatih Istanbul conquest pipeline"):
#   data/projects/{atilla-nin-yukselisi, atilla-nin-y-kselisi, hunlarin-dogusu,
#   hunlarin-dogusu-attila-ya-giden-yol, osmanlinin-kurulusu,
#   fatih-sultan-mehmet-in-i-stanbul-un-fethine-hazirlanisi-cfe77fd8-...}
#   plus the root data/projects/*.json research files.
# Those stay tracked and are untouched by the rules below.
#
# Everything listed here is LOCAL working data: test/diagnostic slugs and
# in-progress / experimental / duplicate pipeline runs that were never
# promoted to git. Files stay on disk. To promote one later: `git add -f`.

# Test / diagnostic slugs — a side effect of scripts/diag-*.ts + smoke suites
# (each holds only an AIUsageManager-written ai-usage.json; regenerated on run).
/data/projects/smoke/
/data/projects/rprobe/
/data/projects/diag-*/
/data/projects/identity-hardening/

# Experimental / in-progress local pipeline runs (0 tracked files each)
/data/projects/i-stanbul-un-fethi-1453/
/data/projects/osmanli-nin-yukselisi-kurulustan-i-stanbul-un-fethine-c8888f58-10d4-4647-8cdb-0f89d8fb5ae4/
