# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-devserver.*.log

# one-off generated reports / dumps (regenerate on demand, do not commit)
/OPENAI-LOCAL-MIGRATION-PLAN.md

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

graphify-out/
.graphify/

.claude/

.agents/

# Local AI runtime binaries + models (installed per-machine, not committed)
/bin/piper/
/data/e2e-output/
